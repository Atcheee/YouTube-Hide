{
  "manifest_version": 3,
  "name": "Playback Plus",
  "version": "2.0.5",
  "description": "Player tools for YouTube and Crunchyroll: one-time auto-skip, custom playback speed, and a cleaner YouTube feed.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://youtube.com/*", "*://*.youtube.com/*",
    "*://crunchyroll.com/*", "*://*.crunchyroll.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Playback Plus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content.js",
        "youtube-sidebar.js",
        "jump-ahead.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://crunchyroll.com/*",
        "*://*.crunchyroll.com/*"
      ],
      "js": ["settings.js", "crunchyroll-skip-intro.js", "crunchyroll-playback-speed.js"],
      "css": ["crunchyroll.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
