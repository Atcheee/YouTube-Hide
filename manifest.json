{
  "manifest_version": 3,
  "name": "YouTube Hide",
  "version": "1.8.3",
  "description": "Hide YouTube clutter, auto-click Jump ahead, and skip Crunchyroll intros once per episode.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "YouTube Hide",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js",
        "jump-ahead.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://crunchyroll.com/*",
        "*://*.crunchyroll.com/*"
      ],
      "js": ["crunchyroll-skip-intro.js", "crunchyroll-playback-speed.js"],
      "css": ["crunchyroll.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
