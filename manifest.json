{
  "manifest_version": 3,
  "name": "Playback Plus",
  "version": "2.0.22",
  "description": "Player tools for YouTube, Crunchyroll, and HBO Max: skipping, playback speed, and shortcuts.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://youtube.com/*", "*://*.youtube.com/*",
    "*://crunchyroll.com/*", "*://*.crunchyroll.com/*",
    "*://hbomax.com/*", "*://*.hbomax.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Playback Plus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://hbomax.com/*", "*://*.hbomax.com/*"],
      "js": ["settings.js", "hbomax-player.js", "crunchyroll-playback-speed.js"],
      "css": ["crunchyroll.css", "hbomax.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content.js",
        "youtube-sidebar.js",
        "jump-ahead.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://crunchyroll.com/*",
        "*://*.crunchyroll.com/*"
      ],
      "js": ["settings.js", "crunchyroll-skip-intro.js", "crunchyroll-playback-speed.js", "crunchyroll-seek.js", "crunchyroll-fullscreen.js"],
      "css": ["crunchyroll.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["*://crunchyroll.com/*", "*://*.crunchyroll.com/*"],
      "js": ["crunchyroll-player-bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
