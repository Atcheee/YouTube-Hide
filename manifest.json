{
  "manifest_version": 3,
  "name": "Playback Plus",
  "version": "2.0.1",
  "description": "Player tools for YouTube and Crunchyroll: one-time auto-skip, custom playback speed, and a cleaner YouTube feed.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Playback Plus",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://youtube.com/*", "*://*.youtube.com/*"],
      "js": ["youtube-player-ui.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content.js",
        "jump-ahead.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://crunchyroll.com/*",
        "*://*.crunchyroll.com/*"
      ],
      "js": ["settings.js", "crunchyroll-skip-intro.js", "crunchyroll-playback-speed.js"],
      "css": ["crunchyroll.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
